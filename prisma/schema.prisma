// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN  // Can see and manage all companies
  ADMIN       // Company admin - can only manage their own company
  MANAGER     // Can manage users and tasks in their company
  USER        // Regular user
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
  ARCHIVED
}

enum FileType {
  IMAGE
  DOCUMENT
  OTHER
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  users       User[]
  groups      Group[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  name         String?
  role         Role        @default(USER)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  tasks        TaskAssignee[]
  ownedGroups  Group[]     @relation("GroupOwner")
  groups       UserGroup[]
  comments     TaskComment[]
  activities   TaskActivity[]
  notifications Notification[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
  @@index([companyId])
}

model Group {
  id          String       @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  owner       User?        @relation("GroupOwner", fields: [ownerId], references: [id])
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id])
  isDefault   Boolean      @default(false)
  tasks       Task[]
  members     UserGroup[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
  @@index([ownerId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?
  groupId     String?
  group       Group?        @relation(fields: [groupId], references: [id])
  assignees   TaskAssignee[]
  checklists  TaskChecklist[]
  files       TaskFile[]
  comments    TaskComment[]
  activities  TaskActivity[]
  notifications Notification[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([groupId])
  @@index([status, priority])
  @@index([dueDate])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskChecklist {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
}

model TaskFile {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename    String
  originalName String
  mimeType    String
  size        Int
  fileType    FileType
  url         String
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([fileType])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  editedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATED, UPDATED, STATUS_CHANGED, ASSIGNEE_ADDED, etc.
  oldValue  String?
  newValue  String?
  metadata  String?  // JSON string for additional data
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // TASK_ASSIGNED, COMMENT_ADDED, TASK_UPDATED, DUE_DATE_APPROACHING
  title     String
  message   String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([taskId])
}

model UserGroup {
  userId   String
  groupId  String
  role     Role      @default(USER)
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
  @@index([groupId])
  @@index([userId])
}
